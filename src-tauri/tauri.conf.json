{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMP Floating Lyrics",
  "version": "0.2.0",
  "identifier": "com.aimp.floatinglyrics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIMP Floating Lyrics",
        "width": 840,
        "height": 180,
        "minWidth": 400,
        "minHeight": 100,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "AIMP Floating Lyrics - Settings",
        "width": 520,
        "height": 680,
        "minWidth": 420,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "search",
        "title": "AIMP Floating Lyrics - Search Lyrics",
        "width": 660,
        "height": 600,
        "minWidth": 500,
        "minHeight": 450,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "unlock",
        "title": "AIMP Lyrics Unlock",
        "width": 38,
        "height": 38,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
